// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id             String              @id @default(cuid())
  name           String?
  email          String?             @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           UserRole            @default(CUSTOMER)
  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  customer       Customer?
  adminUser      AdminUser?
  brandDiscounts UserBrandDiscount[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model AdminUser {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String    @unique
  name        String?
  role        AdminRole @default(STAFF)
  permissions Json?
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
  @@index([role])
}

model Customer {
  id                String   @id @default(cuid())
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email             String   @unique
  firstName         String?
  lastName          String?
  phone             String?
  companyName       String?
  taxId             String?
  billingAddress    Json?
  shippingAddress   Json?
  marketingAccepted Boolean  @default(false)
  orders            Order[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyName])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  description  String?
  parentId     String?
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryTree")
  products     Product[]
  translations CategoryTranslation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([parentId])
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, locale])
  @@index([locale])
}

model Brand {
  id            String              @id @default(cuid())
  name          String
  slug          String              @unique
  products      Product[]
  translations  BrandTranslation[]
  userDiscounts UserBrandDiscount[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model BrandTranslation {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  locale    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, locale])
  @@index([locale])
}

model UserBrandDiscount {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  percent   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, brandId])
  @@index([brandId])
}

model Product {
  id              String                  @id @default(cuid())
  sku             String?                 @unique
  name            String
  slug            String                  @unique
  description     String?                 @db.Text
  gender          String?
  material        String?
  specifications  Json?
  status          ProductStatus           @default(DRAFT)
  isActive        Boolean                 @default(false)
  isFeatured      Boolean                 @default(false)
  minPriceCents   Int?
  maxPriceCents   Int?
  categoryId      String?
  brandId         String?
  category        Category?               @relation(fields: [categoryId], references: [id])
  brand           Brand?                  @relation(fields: [brandId], references: [id])
  images          ProductImage[]
  documents       ProductDocument[]
  variants        ProductVariant[]
  attributeValues ProductAttributeValue[]
  orderItems      OrderItem[]
  translations    ProductTranslation[]
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([status])
  @@index([isActive])
  @@index([isFeatured])
  @@index([minPriceCents])
  @@index([categoryId])
  @@index([brandId])
  @@index([gender])
  @@index([material])
  @@index([name])
}

model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String
  title     String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, url])
  @@index([productId, position])
  @@index([type])
}

model ProductTranslation {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale          String
  name            String
  description     String?  @db.Text
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, locale])
  @@index([locale])
}

model ProductVariant {
  id              String                  @id @default(cuid())
  productId       String
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String                  @unique
  name            String
  color           String?
  colorGroup      String?
  size            String?
  sizeGroup       String?
  priceCents      Int
  compareAtCents  Int?
  currency        String                  @default("EUR")
  stock           Int                     @default(0)
  isActive        Boolean                 @default(true)
  attributes      Json?
  attributeValues VariantAttributeValue[]
  stripePriceId   String?
  orderItems      OrderItem[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([productId])
  @@index([color])
  @@index([colorGroup])
  @@index([size])
  @@index([sizeGroup])
  @@index([isActive])
  @@index([priceCents])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model Attribute {
  id           String                 @id @default(cuid())
  name         String
  slug         String                 @unique
  values       AttributeValue[]
  translations AttributeTranslation[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model AttributeTranslation {
  id          String    @id @default(cuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  locale      String
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([attributeId, locale])
  @@index([locale])
}

model AttributeValue {
  id           String                      @id @default(cuid())
  attributeId  String
  attribute    Attribute                   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value        String
  slug         String
  products     ProductAttributeValue[]
  variants     VariantAttributeValue[]
  translations AttributeValueTranslation[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([attributeId, slug])
  @@index([attributeId])
  @@index([slug])
}

model AttributeValueTranslation {
  id               String         @id @default(cuid())
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  locale           String
  value            String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([attributeValueId, locale])
  @@index([locale])
}

model ProductAttributeValue {
  productId        String
  attributeValueId String
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@index([attributeValueId])
}

model VariantAttributeValue {
  variantId        String
  attributeValueId String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id])
  customerId            String?
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email                 String
  customerName          String?
  customerPhone         String?
  customerCompany       String?
  customerTaxId         String?
  status                OrderStatus   @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  currency              String        @default("EUR")
  subtotalCents         Int
  shippingCents         Int           @default(0)
  taxCents              Int           @default(0)
  totalCents            Int
  stripeCheckoutSession String?       @unique
  stripePaymentIntent   String?
  items                 OrderItem[]
  shippingAddress       Json?
  billingAddress        Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([email])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name              String
  sku               String?
  quantity          Int
  unitCents         Int
  originalUnitCents Int?
  discountPercent   Int?
  totalCents        Int
  createdAt         DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model ImportJob {
  id        String   @id @default(cuid())
  filename  String
  status    String   @default("PENDING")
  rowsTotal Int      @default(0)
  rowsOk    Int      @default(0)
  rowsError Int      @default(0)
  report    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
